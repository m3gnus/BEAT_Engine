{
  "type": "ready",
  "protocol": {
    "name": "beat-worker",
    "version": 1
  },
  "engine": {
    "name": "BEAT Engine",
    "version": "0.3.0"
  },
  "contracts": {
    "system_request": [
      1
    ],
    "compiled_system": [
      1,
      2
    ],
    "system_result": [
      2
    ],
    "field_array": [
      1
    ],
    "mesh_data": [
      1
    ]
  },
  "operations": [
    "solve",
    "bem_field"
  ],
  "precisions": [
    "float32",
    "float64"
  ],
  "solve_kinds": [
    "exterior_bem",
    "interior_fem",
    "coupled_fem_bem_lem"
  ],
  "exterior_source_profiles": [
    "uniform_normal",
    "rigid_translation"
  ],
  "cancellation": "marker_file",
  "field_cache": {
    "lifetime": "worker_process",
    "cleared_on": [
      "solve",
      "failed",
      "process_exit"
    ],
    "max_entries": 2
  },
  "phasor_conventions": [
    "exp(-i omega t)",
    "exp(+i omega t)"
  ],
  "optional_output_quantities": [
    "interface_average_normal_velocity",
    "interface_radiated_pressure"
  ],
  "request_transports": [
    "file",
    "inline_json"
  ]
}
